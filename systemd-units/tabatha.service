[Unit]
Description=Tabatha Discord Bot
After=network-online.target gguf-router.service
Wants=network-online.target

[Service]
Type=simple
User=wendy
Group=discordbots
WorkingDirectory=/home/wendy/waffle_house/llm-multibot-cluster/tabatha
EnvironmentFile=/etc/discord-bots/tabatha.env
ExecStart=/usr/bin/node /home/wendy/waffle_house/llm-multibot-cluster/shared/bot-runtime.js --persona tabatha
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
