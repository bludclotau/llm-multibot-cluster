[Unit]
Description=Gumbo Discord Bot
After=network-online.target llm-sequencer.service
Requires=llm-sequencer.service

[Service]
Type=simple
User=snerloc
Group=snerloc
WorkingDirectory=/home/snerloc/vibe-hub/discord-bots/gumbo
EnvironmentFile=/etc/discord-bots/gumbo.env
ExecStart=/usr/bin/node /home/snerloc/vibe-hub/discord-bots/shared/bot.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target