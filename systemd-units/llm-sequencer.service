[Unit]
Description=LLM Sequencer Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snerloc
Group=snerloc
WorkingDirectory=/home/snerloc/vibe-hub/discord-bots/llm-sequencer
EnvironmentFile=-/etc/discord-bots/sequencer.env
ExecStart=/usr/bin/node /home/snerloc/vibe-hub/discord-bots/llm-sequencer/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target